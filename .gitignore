# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
.ssh/
.aws/
.azure/
id_rsa
id_ecdsa
id_ed25519
/credentials.json
/service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files; DealPatch requires no runtime secrets.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local editor, log and database artifacts; docs and intentional baselines ship.
.vscode/
.idea/
*.log
*.db
*.sqlite
*.sqlite3
Thumbs.db
*.tmp
*.bak
