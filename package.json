  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:seed": "tsc -p tsconfig.seed.json && node node_modules/.cache/dealpatch-seed/scripts/validate-seed.js",
    "test:seed": "tsc -p tsconfig.seed.json && node node_modules/.cache/dealpatch-seed/tests/seed.test.js",
    "test:db": "tsc -p tsconfig.db.json && node node_modules/.cache/dealpatch-db/tests/db.test.js",
    "test:repositories": "tsc -p tsconfig.repositories.json && node node_modules/.cache/dealpatch-repositories/tests/repositories.test.js",
    "test:query": "tsc -p tsconfig.query.json && node node_modules/.cache/dealpatch-query/tests/query.test.js",
    "test:pipeline": "tsc -p tsconfig.pipeline.json && node node_modules/.cache/dealpatch-pipeline/tests/pipeline.test.js",
    "test:reviews": "tsc -p tsconfig.reviews.json && node node_modules/.cache/dealpatch-reviews/tests/reviews.test.js",
    "test:simulation": "tsc -p tsconfig.simulation.json && node node_modules/.cache/dealpatch-simulation/tests/simulation.test.js",
